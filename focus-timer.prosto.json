                  "path": "state.history"
                }
              }
            },
            {
              "id": "session-result",
              "kind": "return",
              "outcome": "succeeded",
              "value": {
                "$": "ref",
                "path": "local.next"
              }
            }
          ]
        }
      ]
    }
  },
