                      {
                        "$": "equals",
                        "left": {
                          "$": "ref",
                          "path": "local.session.countdownId"
                        },
                        "right": "main"
                      }
                    ]
                  },
                  "maximum": 1000
                },
                "path": "0"
              },
              "else": {
                "id": {
                  "$": "ref",
                  "path": "input.owner"
                },
                "owner": {
                  "$": "ref",
                  "path": "input.owner"
                },
                "sessionId": {
                  "$": "ref",
                  "path": "input.sessionId"
