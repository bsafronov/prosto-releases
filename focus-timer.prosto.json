      "type": {
        "kind": "array",
        "items": "CountdownRecord",
        "maximum": 1000
      },
      "default": []
    }
  },
  "version": "1.0.2",
  "interactions": {
    "controls": {
      "role": "work",
      "feature": "prosto/timed-session",
      "title": "interactions.controls.title",
      "source": {
        "collection": "sessions"
      },
      "timing": {
        "collection": "sessions",
        "complete": "complete",
        "pauseProfile": "pauseProfile",
        "rollbackProfile": "resumeProfile",
        "id": "main"
      },
      "nodes": {
        "status": {
          "kind": "timed-status",
          "label": "interactions.controls.nodes.status.label"
        },
        "minutes": {
          "kind": "input",
          "label": "interactions.controls.nodes.minutes.label",
          "type": "integer"
        },
        "quickStart": {
          "kind": "invoke",
          "label": "interactions.controls.nodes.quickStart.label",
          "action": "quickStart",
          "bindings": {}
        },
        "startBreak": {
          "kind": "invoke",
          "label": "interactions.controls.nodes.startBreak.label",
          "action": "startBreak",
          "bindings": {}
        },
        "startCustom": {
          "kind": "invoke",
          "label": "interactions.controls.nodes.startCustom.label",
          "action": "startCustom",
          "bindings": {
            "minutes": {
              "source": "input",
              "input": "minutes"
            }
          }
        },
        "pause": {
          "kind": "invoke",
          "label": "interactions.controls.nodes.pause.label",
          "action": "pause",
          "bindings": {},
          "when": ["running"]
        },
        "resume": {
          "kind": "invoke",
          "label": "interactions.controls.nodes.resume.label",
          "action": "resume",
          "bindings": {},
          "when": ["paused", "profile-paused"]
        },
        "reset": {
          "kind": "invoke",
          "label": "interactions.controls.nodes.reset.label",
          "action": "reset",
          "bindings": {}
        },
        "selectTask": {
          "kind": "invoke",
          "label": "interactions.controls.nodes.selectTask.label",
          "action": "selectTask",
          "bindings": {
            "owner": {
              "source": "timing",
              "field": "owner"
            },
            "sessionId": {
              "source": "generated-identity"
            },
            "nowMs": {
              "source": "timing",
              "field": "nowMs"
            }
          },
          "commit": {
            "collection": "sessions"
          }
        },
        "complete": {
          "kind": "invoke",
          "label": "interactions.controls.nodes.complete.label",
          "action": "complete",
          "bindings": {},
          "when": ["running"],
          "automatic": "expiration",
          "whenExpired": true
        },
        "pauseProfile": {
          "kind": "invoke",
          "label": "interactions.controls.nodes.pauseProfile.label",
          "action": "pauseProfile",
          "bindings": {},
          "when": ["running"],
          "automatic": "profile-pause"
        },
        "resumeProfile": {
          "kind": "invoke",
          "label": "interactions.controls.nodes.resumeProfile.label",
          "action": "resumeProfile",
          "bindings": {},
          "when": ["profile-paused"],
          "automatic": "profile-rollback"
        },
        "retryCompletion": {
          "kind": "invoke",
          "label": "interactions.controls.nodes.retryCompletion.label",
          "action": "complete",
          "bindings": {},
          "when": ["running"],
          "whenExpired": true
        },
        "history": {
          "kind": "source-value",
          "label": "interactions.controls.nodes.history.label",
          "field": "history"
        }
      },
      "capability": {
        "kind": "timer"
      }
    }
  },
  "multiplicity": "many",
  "types": {
    "SelectedTask": {
      "kind": "object",
      "members": {
        "dueAt": {
          "kind": "optional",
          "value": "string"
        },
        "id": "string",
        "priority": "string",
        "tags": {
          "constraint": "label-set",
          "items": "string",
          "kind": "array",
          "maximum": 32
        },
        "title": "string"
      }
    },
    "CountdownRecord": {
      "kind": "object",
      "members": {
        "id": "string",
        "owner": "string",
        "sessionId": "string",
        "phase": "string",
        "durationMs": "integer",
        "remainingMs": "integer",
        "referenceMs": "integer",
        "kind": "string",
        "selectedTask": {
          "kind": "optional",
          "value": "SelectedTask"
        },
        "countdownId": "string"
      }
    }
  },
  "inputs": {
    "selectedTask": {
      "kind": "operation",
      "requestType": "null",
      "resultType": "SelectedTask",
      "expectedFailures": ["task-unavailable"],
      "requirement": "optional",
      "purpose": "prosto.tasks.selected-task"
    }
  },
  "defaultLanguage": "en"
