{
  "actions": {
    "refresh": {
      "expectedFailures": [
        "location-not-found",
        "service-unavailable",
        "invalid-response"
      ],
      "lifecycleScope": "activation",
      "resultType": "Forecast",
      "steps": [
        {
          "id": "refresh-loading",
          "kind": "observe",
          "observation": {
            "kind": "loading"
          }
        },
        {
          "effect": {
            "identity": "forecast",
            "kind": "input"
          },
          "id": "forecast-provider",
          "input": {
            "location": {
              "$": "ref",
              "path": "config.location"
            },
            "temperatureUnit": {
              "$": "ref",
              "path": "config.temperatureUnit"
            }
          },
          "kind": "effect",
          "onFailures": {
            "invalid-response": [
              {
                "condition": {
                  "$": "and",
                  "values": [
                    {
                      "$": "not",
                      "value": {
                        "$": "equals",
                        "left": {
                          "$": "ref",
                          "path": "state.cache"
                        },
                        "right": null
                      }
                    },
                    {
                      "$": "equals",
                      "left": {
                        "$": "ref",
                        "path": "state.cacheKey"
                      },
                      "right": {
                        "location": {
                          "$": "ref",
                          "path": "config.location"
                        },
                        "temperatureUnit": {
                          "$": "ref",
                          "path": "config.temperatureUnit"
                        }
                      }
                    }
                  ]
                },
                "else": [],
                "id": "invalid-cache-match",
                "kind": "branch",
                "then": [
                  {
                    "id": "invalid-mark-stale",
                    "kind": "commit-state",
                    "value": {
                      "cache": {
                        "$": "ref",
                        "path": "state.cache"
                      },
                      "cacheKey": {
                        "$": "ref",
                        "path": "state.cacheKey"
                      },
                      "stale": true
                    }
                  },
                  {
                    "id": "invalid-show-stale",
                    "kind": "observe",
                    "observation": {
                      "kind": "forecast",
                      "stale": true,
                      "value": {
                        "$": "ref",
                        "path": "state.cache"
                      }
                    }
                  }
                ]
              },
              {
                "id": "invalid-failure",
                "kind": "observe",
                "observation": {
                  "code": "invalid-response",
                  "kind": "failure"
                }
              },
              {
                "code": "invalid-response",
                "id": "invalid-return",
                "kind": "return",
                "outcome": "failed"
              }
            ],
            "location-not-found": [
              {
                "condition": {
                  "$": "and",
                  "values": [
                    {
                      "$": "not",
                      "value": {
                        "$": "equals",
                        "left": {
                          "$": "ref",
                          "path": "state.cache"
                        },
                        "right": null
                      }
                    },
                    {
                      "$": "equals",
                      "left": {
                        "$": "ref",
                        "path": "state.cacheKey"
                      },
                      "right": {
                        "location": {
                          "$": "ref",
                          "path": "config.location"
                        },
                        "temperatureUnit": {
                          "$": "ref",
                          "path": "config.temperatureUnit"
                        }
                      }
                    }
                  ]
                },
                "else": [],
                "id": "location-cache-match",
                "kind": "branch",
                "then": [
                  {
                    "id": "location-mark-stale",
                    "kind": "commit-state",
                    "value": {
                      "cache": {
                        "$": "ref",
                        "path": "state.cache"
                      },
                      "cacheKey": {
                        "$": "ref",
                        "path": "state.cacheKey"
                      },
                      "stale": true
                    }
                  },
                  {
                    "id": "location-show-stale",
                    "kind": "observe",
                    "observation": {
                      "kind": "forecast",
                      "stale": true,
                      "value": {
                        "$": "ref",
                        "path": "state.cache"
                      }
                    }
                  }
                ]
              },
              {
                "id": "location-failure",
                "kind": "observe",
                "observation": {
                  "code": "location-not-found",
                  "kind": "failure"
                }
              },
              {
                "code": "location-not-found",
                "id": "location-return",
                "kind": "return",
                "outcome": "failed"
              }
            ],
            "service-unavailable": [
              {
                "condition": {
                  "$": "and",
                  "values": [
                    {
                      "$": "not",
                      "value": {
                        "$": "equals",
                        "left": {
                          "$": "ref",
                          "path": "state.cache"
                        },
                        "right": null
                      }
                    },
                    {
                      "$": "equals",
                      "left": {
                        "$": "ref",
                        "path": "state.cacheKey"
                      },
                      "right": {
                        "location": {
                          "$": "ref",
                          "path": "config.location"
                        },
                        "temperatureUnit": {
                          "$": "ref",
                          "path": "config.temperatureUnit"
                        }
                      }
                    }
                  ]
                },
                "else": [],
                "id": "service-cache-match",
                "kind": "branch",
                "then": [
                  {
                    "id": "service-mark-stale",
                    "kind": "commit-state",
                    "value": {
                      "cache": {
                        "$": "ref",
                        "path": "state.cache"
                      },
                      "cacheKey": {
                        "$": "ref",
                        "path": "state.cacheKey"
                      },
                      "stale": true
                    }
                  },
                  {
                    "id": "service-show-stale",
                    "kind": "observe",
                    "observation": {
                      "kind": "forecast",
                      "stale": true,
                      "value": {
                        "$": "ref",
                        "path": "state.cache"
                      }
                    }
                  }
                ]
              },
              {
                "id": "service-failure",
                "kind": "observe",
                "observation": {
                  "code": "service-unavailable",
                  "kind": "failure"
                }
              },
              {
                "code": "service-unavailable",
                "id": "service-return",
                "kind": "return",
                "outcome": "failed"
              }
            ]
          },
          "onSucceeded": [
            {
              "id": "save-forecast",
              "kind": "commit-state",
              "value": {
                "cache": {
                  "$": "ref",
                  "path": "local.forecast"
                },
                "cacheKey": {
                  "location": {
                    "$": "ref",
                    "path": "config.location"
                  },
                  "temperatureUnit": {
                    "$": "ref",
                    "path": "config.temperatureUnit"
                  }
                },
                "stale": false
              }
            },
            {
              "id": "show-forecast",
              "kind": "observe",
              "observation": {
                "kind": "forecast",
                "stale": false,
                "value": {
                  "$": "ref",
                  "path": "local.forecast"
                }
              }
            },
            {
              "id": "refresh-success",
              "kind": "return",
              "outcome": "succeeded",
              "value": {
                "$": "ref",
                "path": "local.forecast"
              }
            }
          ],
          "result": "forecast"
        }
      ]
    },
    "savedForecast": {
      "requestType": "null",
      "resultType": {
        "kind": "optional",
        "value": {
          "kind": "object",
          "members": {
            "forecast": "Forecast",
            "stale": "boolean"
          }
        }
      },
      "steps": [
        {
          "kind": "branch",
          "condition": {
            "$": "and",
            "values": [
              {
                "$": "not",
                "value": {
                  "$": "equals",
                  "left": {
                    "$": "ref",
                    "path": "state.cache"
                  },
                  "right": null
                }
              },
              {
                "$": "equals",
                "left": {
                  "$": "ref",
                  "path": "state.cacheKey"
                },
                "right": {
                  "location": {
                    "$": "ref",
                    "path": "config.location"
                  },
                  "temperatureUnit": {
                    "$": "ref",
                    "path": "config.temperatureUnit"
                  }
                }
              }
            ]
          },
          "then": [
            {
              "kind": "return",
              "outcome": "succeeded",
              "value": {
                "forecast": {
                  "$": "ref",
                  "path": "state.cache"
                },
                "stale": {
                  "$": "ref",
                  "path": "state.stale"
                }
              }
            }
          ],
          "else": [
            {
              "kind": "return",
              "outcome": "succeeded",
              "value": null
            }
          ]
        }
      ]
    }
  },
  "catalog": {
    "categories": [
      "data",
      "visualization"
    ],
    "license": "MIT",
    "supportLink": "https://github.com/bsafronov/prosto-designer/issues",
    "tags": [
      "forecast",
      "temperature",
      "weather"
    ],
    "description": "catalog.description",
    "displayName": "catalog.displayName",
    "releaseNotes": "catalog.releaseNotes",
    "summary": "catalog.summary"
  },
  "contributions": {
    "attribution": {
      "message": "attribution.openMeteo",
      "url": "https://open-meteo.com/"
    },
    "commands": {
      "refresh": {
        "operation": "refresh",
        "title": "command.refresh"
      }
    }
  },
