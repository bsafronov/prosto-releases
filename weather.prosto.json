  "name": "name",
  "settings": {
    "location": {
      "default": "Berlin",
      "layers": [
        "plugin-default",
        "instance",
        "user",
        "workspace"
      ],
      "live": true,
      "required": true,
      "scope": "user-or-workspace",
      "type": "string",
      "title": "setting.location"
    },
    "temperatureUnit": {
      "default": "celsius",
      "enum": [
        "celsius",
        "fahrenheit"
      ],
      "layers": [
        "plugin-default",
        "instance",
        "user",
        "workspace"
      ],
      "live": true,
      "required": true,
      "scope": "user-or-workspace",
      "type": "string",
      "title": "setting.temperatureUnit"
    }
  },
  "state": {
    "cache": {
      "default": null,
      "type": {
        "kind": "optional",
        "value": "Forecast"
      }
    },
    "cacheKey": {
      "default": null,
      "type": {
        "kind": "optional",
        "value": {
          "kind": "object",
          "members": {
            "location": "string",
            "temperatureUnit": "string"
          }
        }
      }
    },
    "stale": {
      "default": false,
      "type": "boolean"
    }
  },
  "version": "1.1.2",
  "interactions": {
    "forecast": {
      "role": "monitor",
      "feature": "prosto/interaction-composition",
      "title": "interactions.forecast.title",
      "nodes": {
        "refresh": {
          "kind": "invoke",
          "label": "interactions.forecast.nodes.refresh.label",
          "action": "refresh",
          "bindings": {
            "value": {
              "source": "preset",
              "value": null
            }
          }
        },
        "forecast": {
          "kind": "inspect",
          "label": "interactions.forecast.nodes.forecast.label",
          "invocation": "refresh"
        },
        "showSaved": {
          "kind": "invoke",
          "label": "interactions.forecast.nodes.showSaved.label",
          "action": "savedForecast",
          "bindings": {
            "value": {
              "source": "preset",
              "value": null
            }
          }
        },
        "saved": {
          "kind": "inspect",
          "label": "interactions.forecast.nodes.saved.label",
          "invocation": "showSaved"
        }
      },
      "capability": {
        "kind": "monitor",
        "values": [
          "forecast",
          "saved"
        ],
        "refresh": "refresh"
      }
    }
  },
  "types": {
    "Forecast": {
      "kind": "object",
      "members": {
        "attribution": "string",
        "current": {
          "kind": "object",
          "members": {
            "temperature": "number",
            "weatherCode": "integer"
          }
        },
        "daily": {
          "items": {
            "kind": "object",
            "members": {
              "date": "string",
              "maximumTemperature": "number",
              "minimumTemperature": "number",
              "weatherCode": "integer"
            }
          },
          "kind": "array",
          "maximum": 5
        },
        "location": "string",
        "observedAt": "string",
        "unit": "string"
      }
    },
    "ForecastRequest": {
      "kind": "object",
      "members": {
        "location": "string",
        "temperatureUnit": "string"
      }
    }
  },
  "inputs": {
    "forecast": {
      "kind": "operation",
      "requestType": "ForecastRequest",
      "resultType": "Forecast",
      "expectedFailures": [
        "location-not-found",
        "service-unavailable",
        "invalid-response"
      ],
      "requirement": "required",
      "purpose": "prosto.weather.forecast"
    }
  },
  "defaultLanguage": "en"
}
